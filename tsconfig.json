{
  "extends": "@risu729/tsconfigs/bundler",
  "compilerOptions": {
    "incremental": false,
    "lib": ["ESNext"],
    "types": ["@cloudflare/vitest-plugin/types"]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "tools/**/*.ts",
    "*.config.ts",
    "worker-runtime.ts",
    ".cloudflare/types"
  ]
}
